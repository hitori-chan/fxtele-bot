# Copy to .env in the repo root. Only TELEGRAM_BOT_TOKEN is required, and with RUST_LOG it's all
# the bot's container gets; the rest is the server's.

# The bot polls with it; the server uses it only to send alerts.
TELEGRAM_BOT_TOKEN=

# --- server ---

# Loopback, as compose.yml uses the host's network. Unset, the listeners are on 0.0.0.0.
PUBLIC_ADDR=127.0.0.1:8080
DASHBOARD_ADDR=127.0.0.1:8081

# Where the client's IP comes from: peer, cf-connecting-ip, x-forwarded-for or x-real-ip.
# Use the header your front end sets with the client's address (x-real-ip, say); behind
# Cloudflare's proxy, it takes that from CF-Connecting-IP, believed only from Cloudflare's
# addresses. The front end must set the header itself, replacing any the client sent, and be the
# only way to reach the listeners: whoever can set it can claim to be Telegram.
#CLIENT_IP_FROM=peer
# Front ends allowed to set that header (comma-separated). Default: loopback only. Add the front
# end's address when it runs elsewhere, e.g. on a container network.
#TRUSTED_PROXIES=127.0.0.0/8,::1/128,10.89.0.0/24

# The dashboard's public URL. Needed for passkeys, and for full setup links in the log.
#DASHBOARD_URL=https://homura.example.com

# Each site's preview hostname. A site without one works only in the dashboard.
#FACEBOOK_HOST=fb.example.com
#INSTAGRAM_HOST=ig.example.com
#REDDIT_HOST=rd.example.com
#THREADS_HOST=th.example.com

# Cloudflare Access in front of the dashboard: team name (<team>.cloudflareaccess.com) and the
# application's audience tag. Set both or neither.
#ACCESS_TEAM=
#ACCESS_AUD=

# A private bucket with S3's API (Cloudflare R2, Garage...), needed for 1080p videos. Telegram
# downloads them from this address through signed links. See docs/deployment.md. The S3 API
# address ends with the bucket's name.
#VIDEO_BUCKET=https://<account>.r2.cloudflarestorage.com/<bucket>
#VIDEO_BUCKET_KEY_ID=
#VIDEO_BUCKET_SECRET=
# R2 takes auto; Garage wants its s3_region.
#VIDEO_BUCKET_REGION=auto

# Log detail, e.g. info or server=debug,info.
#RUST_LOG=info
